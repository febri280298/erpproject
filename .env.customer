# ===========================================================================
#  Contoh .env untuk PEMASANGAN DI TEMPAT CUSTOMER.
#
#  Bedanya dengan .env.example: APP_ENV sudah production dan APP_DEBUG sudah
#  false. Keduanya yang mencegah transaksi contoh ikut terpasang dan mencegah
#  isi berkas ini tampil di layar ketika ada galat.
#
#  Berkas inilah yang disalin menjadi .env oleh buat-paket.bat. Yang perlu
#  diubah hanya APP_NAME di bawah. APP_KEY sengaja dibiarkan kosong: kuncinya
#  dibuat sendiri oleh pasang-erp.bat di komputer customer, jadi tiap customer
#  memakai kunci yang berbeda.
# ===========================================================================
APP_NAME="GANTI DENGAN NAMA PERUSAHAAN CUSTOMER"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:7001

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erppeak
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="erp@bonecomtricom.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- ERP Settings ----
ERP_COMPANY_NAME="PT Bonecom Tricom"
ERP_CURRENCY=IDR
ERP_TAX_RATE=11
ERP_FISCAL_YEAR_START=01-01
